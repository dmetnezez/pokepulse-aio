# ── Session signing (required in production) ───────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Storage backend ───────────────────────────────────────────────────────
# Leave the Supabase vars empty to run in LOCAL DEMO mode (JSON file store in .data/,
# built-in auth, embedded worker). Fill them in to use Supabase Auth + Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# embedded = the monitor runs inside the Next.js server process (default)
# external = run `npm run worker` as a separate process (Supabase mode only)
WORKER_MODE=embedded

# ── Retailer integrations (authorized APIs only) ──────────────────────────
# Amazon.ca — Product Advertising API 5.0 (requires an approved Amazon Associates account)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# ── Notification providers ────────────────────────────────────────────────
# Email alerts are sent through Resend (https://resend.com). Discord/Telegram are configured per-user in the app.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
